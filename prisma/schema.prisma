// ============================================================
// CACI HUB — Prisma Schema
// Provider: Supabase / PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- Enums (mirror PostgreSQL enum types) ----

enum GenderType {
  male
  female

  @@map("gender_type")
}

enum MaritalStatusType {
  single
  married
  divorced
  widowed
  other

  @@map("marital_status_type")
}

enum MembershipStatus {
  visitor
  active
  inactive

  @@map("membership_status")
}

// ---- Auth & Users ----

model UserProfile {
  id                   String   @id @default(uuid())
  role                 String   @default("member") // 'admin' | 'member'
  fullName             String   @map("full_name")
  isActive             Boolean  @default(true) @map("is_active")
  mustChangePassword   Boolean  @default(false) @map("must_change_password")
  phone                String   @unique
  passwordHash         String   @map("password_hash")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  broadcastsSent       Broadcast[]
  groupsCreated        Group[]
  permissionsGranted   MemberPermission[] @relation("PermissionGrantedBy")
  sermonsCreated       Sermon[]
  seriesCreated        SermonSeries[]
  auditEntries         MemberAuditLog[]

  @@index([role])
  @@index([isActive])
  @@map("user_profiles")
}

model MemberCounter {
  id          Int     @id @default(1)
  lastNumber  Int     @default(0) @map("last_number")

  @@map("member_counter")
}

// ---- Members ----

model Member {
  id                              String    @id @default(uuid())
  membershipNumber                String?   @unique @map("membership_number")
  title                           String?
  fullName                        String    @map("full_name")
  dateOfBirth                     DateTime? @map("date_of_birth")
  gender                          GenderType?
  maritalStatus                   MaritalStatusType? @map("marital_status")
  occupation                      String?
  location                        String?
  phoneNumber                     String?   @map("phone_number")
  whatsappNumber                  String?   @map("whatsapp_number")
  membershipStatus                MembershipStatus @default(visitor) @map("membership_status")
  assemblyRole                    String?   @map("assembly_role")
  joinDate                        DateTime? @map("join_date")
  profilePhotoUrl                 String?   @map("profile_photo_url")
  emergencyContactName            String?   @map("emergency_contact_name")
  emergencyContactPhone           String?   @map("emergency_contact_phone")
  emergencyContactRelationship    String?   @map("emergency_contact_relationship")
  isActive                        Boolean   @default(true) @map("is_active")
  deletedAt                       DateTime? @map("deleted_at")
  authUserId                      String?   @unique @map("auth_user_id")
  createdById                     String?   @map("created_by")
  createdAt                       DateTime  @default(now()) @map("created_at")
  updatedAt                       DateTime  @updatedAt @map("updated_at")

  groups                          GroupMember[]
  permissions                     MemberPermission[]
  notifications                   Notification[]
  broadcastRecipients             BroadcastRecipient[]
  forumMessages                   ForumMessage[]
  groupMessages                   GroupMessage[]
  auditLogs                       MemberAuditLog[]
  ledGroups                       Group[]

  @@index([membershipStatus])
  @@index([isActive])
  @@index([authUserId])
  @@map("members")
}

model MemberPermission {
  id          String   @id @default(uuid())
  memberId    String   @map("member_id")
  permission  String
  grantedById String   @map("granted_by")
  grantedBy   UserProfile @relation("PermissionGrantedBy", fields: [grantedById], references: [id])
  grantedAt   DateTime @default(now()) @map("granted_at")

  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, permission])
  @@index([memberId])
  @@map("member_permissions")
}

model SystemPermission {
  key         String   @id
  label       String
  description String
  module      String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("system_permissions")
}

// ---- Groups ----

model Group {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  leaderId       String?  @map("leader_id")
  messagingMode  String   @default("open") @map("messaging_mode")
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String?  @map("created_by")
  createdBy      UserProfile? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  leader         Member?  @relation(fields: [leaderId], references: [id], onDelete: SetNull)
  members        GroupMember[]
  broadcasts     Broadcast[]
  messages       GroupMessage[]

  @@index([isActive])
  @@map("groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  memberId  String   @map("member_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
  @@index([groupId])
  @@index([memberId])
  @@map("group_members")
}

// ---- Broadcasts & Notifications ----

model Broadcast {
  id             String   @id @default(uuid())
  sentById       String   @map("sent_by")
  sentBy         UserProfile @relation(fields: [sentById], references: [id])
  title          String
  body           String
  targetGroupId  String?  @map("target_group_id")
  targetingMode  String   @default("assembly") @map("targeting_mode")
  attachmentUrl  String?  @map("attachment_url")
  sentAt         DateTime @default(now()) @map("sent_at")

  targetGroup    Group?   @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  recipients     BroadcastRecipient[]
  notifications  Notification[]

  @@index([sentAt])
  @@index([targetingMode])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id          String   @id @default(uuid())
  broadcastId String   @map("broadcast_id")
  memberId    String   @map("member_id")

  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, memberId])
  @@index([broadcastId])
  @@map("broadcast_recipients")
}

model Notification {
  id          String   @id @default(uuid())
  memberId    String   @map("member_id")
  broadcastId String?  @map("broadcast_id")
  title       String
  body        String
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  broadcast   Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([memberId, isRead, createdAt])
  @@index([memberId, createdAt])
  @@map("notifications")
}

// ---- Audit ----

model MemberAuditLog {
  id           String   @id @default(uuid())
  memberId     String   @map("member_id")
  changedById  String?  @map("changed_by")
  fieldChanged String   @map("field_changed")
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  changedAt    DateTime @default(now()) @map("changed_at")

  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  changedBy    UserProfile? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([memberId, changedAt])
  @@map("member_audit_log")
}

// ---- Assembly Settings (single-row) ----

model AssemblySetting {
  id                  String   @id @default(uuid())
  assemblyName        String   @default("Assakae Central Assembly") @map("assembly_name")
  assemblyLocation    String   @default("Assakae District") @map("assembly_location")
  assemblyAddress     String?  @map("assembly_address")
  contactPhone        String?  @map("contact_phone")
  contactEmail        String?  @map("contact_email")
  defaultPassword     String   @default("CACI@2026!") @map("default_password")
  forcePasswordReset  Boolean  @default(true) @map("force_password_reset")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("assembly_settings")
}

// ---- Sermon Series ----

model SermonSeries {
  id          String    @id @default(uuid())
  title       String
  description String?
  theme       String?
  anchorText  String?   @map("anchor_text")
  coverImage  String?   @map("cover_image")
  year        Int       @default(2025)
  status      String    @default("ongoing") // 'ongoing' | 'completed'
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdById String?   @map("created_by")
  createdBy   UserProfile? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sermons     Sermon[]

  @@index([status])
  @@index([year])
  @@map("sermon_series")
}

// ---- Sermons ----

model Sermon {
  id                 String        @id @default(uuid())
  seriesId           String?       @map("series_id")
  series             SermonSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  sequence           Int           @default(1)
  title              String
  speaker            String
  date               DateTime
  description        String?
  theme              String?
  scriptureReference String?       @map("scripture_reference")
  quotations         Json          @default("[]")
  audioUrl           String?       @map("audio_url")
  videoUrl           String?       @map("video_url")
  coverImageUrl      String?       @map("cover_image_url")
  durationSeconds    Int?          @map("duration_seconds")
  createdById        String?       @map("created_by")
  createdBy          UserProfile?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([date])
  @@index([seriesId, sequence])
  @@map("sermons")
}

// ---- Forum (assembly-wide message board) ----

model ForumMessage {
  id         String   @id @default(uuid())
  memberId   String   @map("member_id")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("forum_messages")
}

// ---- Group Chat Messages ----

model GroupMessage {
  id         String   @id @default(uuid())
  groupId    String   @map("group_id")
  memberId   String   @map("member_id")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("group_messages")
}

// ---- Ministries ----

model Ministry {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  leader      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ministries")
}

