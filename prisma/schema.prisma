// ============================================================
// CACI HUB — Prisma Schema
// Scope: Membership Management + Sermons Management only
// Provider: Supabase / PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

// ---- Enums ----

enum GenderType {
  male
  female

  @@schema("public")
  @@map("gender_type")
}

enum MaritalStatusType {
  single
  married
  divorced
  widowed
  other

  @@schema("public")
  @@map("marital_status_type")
}

enum MembershipStatus {
  visitor
  active
  inactive

  @@schema("public")
  @@map("membership_status")
}

// ---- Auth & Users ----

model UserProfile {
  id                 String   @id @default(uuid())
  role               String   @default("member") // 'admin' | 'member'
  fullName           String   @map("full_name")
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  phone              String   @unique
  passwordHash       String   @map("password_hash")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  sermonsCreated     Sermon[]
  auditEntries       MemberAuditLog[]

  @@index([role])
  @@index([isActive])
  @@map("user_profiles")
  @@schema("public")
}

model MemberCounter {
  id         Int @id @default(1)
  lastNumber Int @default(0) @map("last_number")

  @@map("member_counter")
  @@schema("public")
}

// ---- Members ----

model Member {
  id                           String             @id @default(uuid())
  membershipNumber             String?            @unique @map("membership_number")
  title                        String?
  fullName                     String             @map("full_name")
  dateOfBirth                  DateTime?          @map("date_of_birth")
  gender                       GenderType?
  maritalStatus                MaritalStatusType? @map("marital_status")
  occupation                   String?
  location                     String?
  phoneNumber                  String?            @map("phone_number")
  whatsappNumber               String?            @map("whatsapp_number")
  membershipStatus             MembershipStatus   @default(visitor) @map("membership_status")
  assemblyRole                 String?            @map("assembly_role")
  joinDate                     DateTime?          @map("join_date")
  profilePhotoUrl              String?            @map("profile_photo_url")
  emergencyContactName         String?            @map("emergency_contact_name")
  emergencyContactPhone        String?            @map("emergency_contact_phone")
  emergencyContactRelationship String?            @map("emergency_contact_relationship")
  isActive                     Boolean            @default(true) @map("is_active")
  deletedAt                    DateTime?          @map("deleted_at")
  authUserId                   String?            @unique @map("auth_user_id")
  createdById                  String?            @map("created_by")
  createdAt                    DateTime           @default(now()) @map("created_at")
  updatedAt                    DateTime           @updatedAt @map("updated_at")

  auditLogs MemberAuditLog[]

  @@index([membershipStatus])
  @@index([isActive])
  @@index([authUserId])
  @@map("members")
  @@schema("public")
}

model MemberAuditLog {
  id           String      @id @default(uuid())
  memberId     String      @map("member_id")
  changedById  String?     @map("changed_by")
  fieldChanged String      @map("field_changed")
  oldValue     String?     @map("old_value")
  newValue     String?     @map("new_value")
  changedAt    DateTime    @default(now()) @map("changed_at")

  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  changedBy UserProfile? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([memberId, changedAt])
  @@map("member_audit_log")
  @@schema("public")
}

// ---- Assembly Settings (single-row) ----

model AssemblySetting {
  id                 String   @id @default(uuid())
  assemblyName       String   @default("Assakae Central Assembly") @map("assembly_name")
  assemblyLocation   String   @default("Assakae District") @map("assembly_location")
  assemblyAddress    String?  @map("assembly_address")
  contactPhone       String?  @map("contact_phone")
  contactEmail       String?  @map("contact_email")
  defaultPassword    String   @default("CACI@2026!") @map("default_password")
  forcePasswordReset Boolean  @default(true) @map("force_password_reset")
  customRoles        String[] @default([]) @map("custom_roles")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("assembly_settings")
  @@schema("public")
}

// ---- Sermons ----

model Sermon {
  id                 String       @id @default(uuid())
  sequence           Int          @default(1)
  title              String
  speaker            String
  speakerRole        String?      @map("speaker_role")
  date               DateTime
  summary            String?
  description        String?
  theme              String?
  scriptureReference String?      @map("scripture_reference")
  keyTakeaways       Json         @default("[]") @map("key_takeaways")
  quotations         Json         @default("[]")
  coverImageUrl      String?      @map("cover_image_url")
  durationSeconds    Int?         @map("duration_seconds")
  createdById        String?      @map("created_by")
  createdBy          UserProfile? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  media SermonMedia[]

  @@index([date])
  @@index([sequence])
  @@map("sermons")
  @@schema("public")
}

// One of each media type per sermon: video | audio | pdf | text
model SermonMedia {
  id          String   @id @default(uuid())
  sermonId    String   @map("sermon_id")
  sermon      Sermon   @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  type        String   // "video" | "audio" | "pdf" | "text"
  url         String
  label       String?
  description String?
  sequence    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([sermonId, type])
  @@index([sermonId, sequence])
  @@map("sermon_media")
  @@schema("public")
}
